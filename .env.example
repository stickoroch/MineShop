# === Telegram ===
TG_TOKEN=123456:replace-me
TG_PROXY_ENABLED=false
TG_PROXY_ADDRESS=127.0.0.1:9150

# === YooKassa ===
YOOKASSA_SHOP_ID=000000
YOOKASSA_TOKEN=replace-me
YOOKASSA_RETURN_URL=https://t.me/your_bot

# === WebSocket-мост с Paper-плагином ===
PLUGIN_TOKEN=replace-with-long-random-token
PLUGIN_MAX_ATTEMPTS=10
PLUGIN_STALE_MINUTES=2
PLUGIN_SESSION_TIMEOUT_SECONDS=90

# === Административная панель ===
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-strong-password
ADMIN_TOKEN_TTL_HOURS=12

# === База данных (только для профиля prod) ===
# Раскомментируйте для production:
# SPRING_PROFILES_ACTIVE=prod
DB_URL=jdbc:postgresql://localhost:5432/mineshop
DB_USERNAME=mineshop
DB_PASSWORD=replace-me
DB_POOL_SIZE=10
DB_MIN_IDLE=2

# === Прочее ===
SERVER_PORT=8080
MEDIA_COVER_ROOT=./media/covers
MINECRAFT_PROFILE_CHECK_ENABLED=true
MOJANG_PROFILE_API_URL=https://api.mojang.com
MOJANG_PROFILE_TIMEOUT_MS=3000
